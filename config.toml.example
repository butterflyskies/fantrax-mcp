# fantrax-mcp configuration
#
# Copy this file to config.toml and fill in your values.
# config.toml is gitignored — never commit credentials.

[fantrax]
# Your Fantrax user secret ID. Found in Fantrax account settings under
# "API Access" or extracted from authenticated API requests. This is used
# as a query parameter to authenticate against the Fantrax beta API.
# REQUIRED — the server will not start without it.
user_secret_id = "YOUR_SECRET_ID_HERE"

# ─── Leagues ────────────────────────────────────────────────────────────────
#
# Define one or more [[leagues]] entries. Use `list_leagues` MCP tool (or the
# Fantrax getLeagues endpoint) to discover your league IDs.
#
# Fields:
#   id          — Fantrax league ID string (required)
#   name        — Human-readable name (required)
#   league_type — Scoring format: h2h | roto | hybrid | custom (required)
#   lineup      — Lineup cadence: daily | weekly | bestball | worstball (required)
#   keeper      — Is this a keeper league? (optional, default: false)

[[leagues]]
id = "abc123"
name = "Main League"
league_type = "h2h"
lineup = "daily"
keeper = false

# [[leagues]]
# id = "def456"
# name = "Keeper League"
# league_type = "roto"
# lineup = "daily"
# keeper = true

# [[leagues]]
# id = "ghi789"
# name = "Weekly H2H"
# league_type = "h2h"
# lineup = "weekly"
# keeper = false

# [[leagues]]
# id = "jkl012"
# name = "Best Ball"
# league_type = "custom"
# lineup = "bestball"
# keeper = false

[projections]
# Projection stat type from the MLB Stats API.
# Options: projected, projectedRos, projected_Zips, projected_ZipsRos,
#          projected_Zips2YR, projected_Zips3YR
# NOTE: FanGraphs values (steamer, zips, atc, thebat, thebatx) are no
# longer valid. If you have an old config, the server will log a warning
# and default to projected_ZipsRos.
source = "projected_ZipsRos"

# How often to refresh cached projections, in hours.
refresh_hours = 24

[server]
# Address to bind to. Use "0.0.0.0" to listen on all interfaces
# (required for Docker / container deployments).
# Default: "127.0.0.1" (localhost only)
bind_addr = "127.0.0.1"

# Port for the MCP HTTP server.
port = 3001

# Path to the SQLite database file. Tilde (~) expands to $HOME.
# Parent directories are created automatically if they don't exist.
db_path = "~/.local/share/fantrax-mcp/fantrax.db"

# IANA timezone used to compute default dates ("today" / "yesterday") for
# tools that accept an optional date (get_probable_starters, optimize_lineup,
# get_briefing, get_player_snippet).
#
# Default: "America/New_York". MLB Stats API schedule dates are anchored to
# US Eastern time, and Eastern midnight roughly coincides with the end of the
# night's slate — so Eastern is the right default even if you live elsewhere.
# (Computing "today" in UTC rolls to tomorrow at 8pm ET / 5pm PT, mid-slate,
# which made evening tool calls target the wrong day's schedule.)
timezone = "America/New_York"
